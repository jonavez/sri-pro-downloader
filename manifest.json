{
  "manifest_version": 3,
  "name": "SRI Pro XML - Descarga Masiva de Comprobantes",
  "version": "3.6.0",
  "description": "Herramienta profesional para descarga masiva, gesti\u00f3n de XMLs del SRI Ecuador y sincronizaci\u00f3n con EMITE.ec.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://srienlinea.sri.gob.ec/*",
    "https://api.emite.ec/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://srienlinea.sri.gob.ec/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "minimum_chrome_version": "120",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
